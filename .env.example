# Vorlage für die Datei .env
# Kopieren als .env, eigene Werte eintragen und mit chmod 600 schuetzen.
# Die echte .env-Datei gehoert NICHT in Git.
#
# Passwoerter erzeugen mit: openssl rand -base64 24

DB_ROOT_PASSWORD=hier_ein_langes_zufaelliges_passwort
DB_PASSWORD=hier_ein_anderes_langes_zufaelliges_passwort
TRUSTED_DOMAINS=192.168.XXX.XXX localhost

# Hinweis: Das Passwort des Nextcloud-Administrators steht NICHT in dieser
# Datei. Es wird bei der Installation im Browser gesetzt und ist ein drittes,
# davon unabhaengiges Passwort.

